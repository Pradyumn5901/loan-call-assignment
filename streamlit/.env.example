# ─────────────────────────────────────────────────────────────────────────────
# Loan Collection Analysis — environment configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored; .env.example is checked in.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (local GGUF via llama-cpp-python) ────────────────────────────────────
# Path to GGUF model file inside the models/ directory.
LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf

# Context window in tokens (default: 2048)
LLM_N_CTX=2048

# Max tokens the model can generate per call (default: 512)
LLM_MAX_TOKENS=512

# CPU threads for inference (default: auto-detect)
# LLM_N_THREADS=4

# Set to 1 to enable verbose llama.cpp loading output (default: 0)
# LLM_VERBOSE=0

# ── ML models ────────────────────────────────────────────────────────────────
# Directory where trained .joblib artifacts are stored.
ML_MODEL_DIR=models

HF_TOKEN = 